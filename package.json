{
  "name": "trackwell",
  "private": true,
  "version": "0.1.0",
  "description": "Trackwell \u2014 Work. Earn. Understand. Unified work-income and expense tracking.",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.legacy.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "profile:legacy": "node tools/legacy/profile.mjs",
    "dev:api": "wrangler dev --local --port 8787 --ip 127.0.0.1",
    "dev:api:ai": "wrangler dev --config wrangler.ai-test.toml --port 8787 --ip 127.0.0.1",
    "dev:api:ai:granite": "wrangler dev --config wrangler.ai-test.toml --port 8787 --ip 127.0.0.1 --var AI_MODEL:@cf/ibm-granite/granite-4.0-h-micro",
    "ai:eval": "tsx tools/ai-eval.ts",
    "ai:genuine-test": "node tools/ai-genuine-test.mjs",
    "dev:setup": "node tools/dev-setup.mjs && npm run db:migrate:local",
    "db:migrate:local": "wrangler d1 migrations apply trackwell --local",
    "db:seed:synthetic": "tsx tools/seed-synthetic.ts && wrangler d1 execute trackwell --local --file .local/seed.sql",
    "migrate:legacy": "tsx tools/migrate/legacy-import.ts"
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "5.3.0",
    "lucide-react": "1.75.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2",
    "recharts": "3.11.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "^5.20261118.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "^4.164.0"
  }
}
